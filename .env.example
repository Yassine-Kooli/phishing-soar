# Copy to .env (git-ignored) and fill in only what you use. Never commit real keys.
# Everything works without these: the local feed (analyzer/ioc/domains.txt) covers the demo.
URLHAUS_AUTH_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
IRIS_API_KEY=

# Host ports. Defaults are the contract values; change one only if it is already taken.
# Scripts (demo/*.py) read MAILPIT_UI_PORT / MAILPIT_SMTP_PORT too.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SINKHOLE_HOST_PORT=5353
GOPHISH_ADMIN_PORT=3333
GOPHISH_PHISH_PORT=8081
