# Copy to .env (git-ignored) and fill in only what you use. Never commit real keys.
# Everything works without these: the local feed (analyzer/ioc/domains.txt) covers the demo.
URLHAUS_AUTH_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
IRIS_API_KEY=
# GoPhish admin API key: admin UI, Settings, "Show" (used by demo/gophish_setup.py)
GOPHISH_API_KEY=

# Approval links are signed with this key. Generate one: python3 -c "import secrets;print(secrets.token_hex(32))"
APPROVAL_SECRET=
# How long an analyst has to decide (seconds). After that the request expires and nothing is purged.
APPROVAL_TTL_SECONDS=600
# Demo lab only: lets demo/scenario.py expire leftover open requests between runs. Keep 0 elsewhere.
LAB_RESET=0

# Host ports. Defaults are the contract values; change one only if it is already taken.
# Scripts (demo/*.py) read MAILPIT_UI_PORT / MAILPIT_SMTP_PORT too.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SINKHOLE_HOST_PORT=5353
GOPHISH_ADMIN_PORT=3333
GOPHISH_PHISH_PORT=8081
