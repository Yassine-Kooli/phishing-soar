    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const a = $('Analyze').item.json;\nlet key = '';\ntry { key = ($env.URLHAUS_AUTH_KEY || '').trim(); } catch (e) { key = ''; }\nconst unavailable = [];   // a CONFIGURED source that failed: forces review, never safe\nconst disabled = [];      // a source left unconfigured on purpose: reported, does not downgrade\nlet urlhaus_hits = 0, bad_hashes = 0;\nconst failed = (name) => { if (!unavailable.includes(name)) unavailable.push(name); };\n\nif (a.urls.length > 0) {\n  if (!key) {\n    disabled.push('urlhaus');\n  } else {\n    for (const u of a.urls) {\n      try {\n        const r = await this.helpers.httpRequest({\n          method: 'POST',\n          url: 'https://urlhaus-api.abuse.ch/api/v1/url/',\n          headers: { 'Auth-Key': key, 'Content-Type': 'application/x-www-form-urlencoded' },\n          body: new URLSearchParams({ url: u.url }).toString(),\n          json: true, timeout: 5000,\n        });\n        if (r.query_status === 'ok') urlhaus_hits++;\n        else if (r.query_status !== 'no_results') failed('urlhaus');\n      } catch (e) { failed('urlhaus'); }\n    }\n  }\n}\n\n// CIRCL needs no key. HTTP 404 = unknown (not a verdict). Any other error = unavailable.\nfor (const x of a.attachments) {\n  try {\n    const r = await this.helpers.httpRequest({\n      method: 'GET',\n      url: 'https://hashlookup.circl.lu/lookup/sha256/' + x.sha256,\n      json: true, timeout: 5000,\n    });\n    if (r.KnownMalicious) bad_hashes++;\n  } catch (e) {\n    const code = String(e.httpCode ?? e.statusCode ?? '');\n    if (code !== '404') failed('circl');\n  }\n}\n\nreturn { json: { analysis: a, reputation: { urlhaus_hits, bad_hashes, unavailable, disabled } } };"
      },
