{
  "id": "approvalResp0002",
  "name": "02-approval-response",
  "nodes": [
    {
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Approval link",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "5f6b1c2e-0000-4000-8000-000000000001",
      "parameters": {
        "httpMethod": "GET",
        "path": "approval",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Decide",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://analyzer:8000/approvals/{{ $json.query.id }}/decide",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { action: $json.query.action, token: $json.query.token } }}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Respond refused",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        460
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "=Refused, no action was taken: {{ $json.error?.message ?? 'not valid' }}",
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b2000000-0000-4000-8000-000000000004-c",
              "leftValue": "={{ $json.status }}",
              "rightValue": "approved",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": false
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Execute purge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://analyzer:8000/approvals/{{ $('Decide').first().json.id }}/execute",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Verify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "=http://analyzer:8000/approvals/{{ $('Decide').first().json.id }}/verify",
        "options": {
          "timeout": 40000
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Verified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b2000000-0000-4000-8000-000000000007-c",
              "leftValue": "={{ $json.ok }}",
              "rightValue": null,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Build notices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ex = $('Execute purge').first().json;\nconst dec = $('Decide').first().json;\nconst ver = $input.first().json;\nconst blocked = ex.blocked || [];\nconst victims = (ex.recipients || []).filter(t => t !== dec.reporter);\nconst out = [];\nfor (const to of victims) {\n  out.push({ json: { to, subject: 'Phishing e-mail removed from your mailbox',\n    text: 'A phishing e-mail reported by a colleague was removed from your mailbox.\\n' +\n          'Do not click its links or open its attachments.\\n' +\n          'Subject of the removed e-mail: ' + dec.subject } });\n}\nout.push({ json: { to: dec.reporter, subject: 'Thanks: the phishing campaign was removed',\n  text: 'Your report was confirmed as phishing. Copies removed: ' + ex.deleted.length +\n        '. Domains blocked: ' + (blocked.join(', ') || 'none') + '.' } });\nout.push({ json: { to: 'analyst@corp.local', subject: '[purged] approval ' + dec.id + ' verified',\n  text: 'Copies removed: ' + ex.deleted.length + '\\nQuarantine copies: ' + ex.quarantined.map(q => q.path).join(', ') +\n        '\\nDomains blocked: ' + (blocked.join(', ') || 'none') +\n        '\\nDNS sinkhole check: ' + JSON.stringify(ver.dns_blocked) + '\\nCopies left in mailboxes: ' + ver.copies_left } });\nreturn out;\n"
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Send notices",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1540,
        160
      ],
      "parameters": {
        "fromEmail": "soc@corp.local",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "smtpMailpit01",
          "name": "Mailpit SMTP"
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-00000000000a",
      "name": "Collect",
